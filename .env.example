# Plantilla del único .env del repo (raíz). Copiá este archivo como .env y
# completá los valores reales. Lo consumen los stacks de servicios/ vía
# env_file: ../../.env: la app lee MONGO_USER/MONGO_PASS en runtime y mongodb
# lee MONGO_INITDB_ROOT_USERNAME/MONGO_INITDB_ROOT_PASSWORD por nombre directo.

# Credenciales de la app (config/settings.py)
MONGO_USER=dummy_user
MONGO_PASS=dummy_pass

# Credenciales de inicialización de MongoDB (entrypoint del servicio mongodb).
# Deben coincidir con MONGO_USER/MONGO_PASS.
MONGO_INITDB_ROOT_USERNAME=dummy_user
MONGO_INITDB_ROOT_PASSWORD=dummy_pass

# Opcionales (estos son los valores por defecto; solo los lee la app)
MONGO_HOST=mongodb
MONGO_PORT=27017
